# ==============================================================================
# CODESAGE AI — GLOBAL ENVIRONMENT CONFIGURATION MATRIX
# ==============================================================================

# Required Third-Party API Credentials
GEMINI_API_KEY=your_google_gemini_api_key_here
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# GitHub App Integration & OAuth 2.0
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="YOUR_GITHUB_APP_PRIVATE_KEY_PEM_HERE"
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Monitored Repositories & Security
CODESAGE_REPOSITORIES=owner/repo1,owner/repo2
CORS_ORIGINS=http://localhost:3000,https://app.codesage.ai
JWT_SECRET_KEY=codesage-ai-super-secret-jwt-key-2026-secure

# Production Database & Redis Connection URLs
DATABASE_URL=postgresql://codesage:codesage_pass@postgres:5432/codesage_db
REDIS_URL=redis://redis:6379/0

# Worker Execution & Performance Parameters
WORKER_CONCURRENCY=5
MAX_RETRIES=3
JOB_TIMEOUT=300
GEMINI_MODEL=gemini-2.5-flash
